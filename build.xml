<?xml version="1.0" encoding="UTF-8"?>
<project name="TrabalhoPratico5" default="default" basedir=".">
    <description>Compila e executa o Trabalho Pratico 5.</description>
    <property file="nbproject/project.properties"/>
    
    <target name="init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" includeantruntime="false" encoding="UTF-8"/>
    </target>

    <target name="jar" depends="compile">
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>

    <target name="run" depends="compile">
        <java classname="${main.class}" classpath="${build.classes.dir}" fork="true"/>
    </target>

    <target name="default" depends="jar"/>
</project>
